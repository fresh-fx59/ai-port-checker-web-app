# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/gemini_web_app_dev
DATABASE_USERNAME=gemini_user
DATABASE_PASSWORD=gemini_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Development versions (optional)
GOOGLE_CLIENT_ID_DEV=dev-google-client-id
GOOGLE_CLIENT_SECRET_DEV=dev-google-client-secret

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-pro

# Development versions (optional)
GEMINI_API_KEY_DEV=dev-gemini-api-key

# Security Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server Configuration (Production)
SERVER_PORT=8080

# Quota Configuration (optional)
ANONYMOUS_REQUEST_QUOTA=1
REGISTERED_REQUEST_QUOTA=5

# JWT Configuration (optional)
JWT_EXPIRATION=86400000