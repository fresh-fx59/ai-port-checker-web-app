# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Database Configuration
DATABASE_NAME=gemini_web_app
DATABASE_USERNAME=your_secure_username
DATABASE_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# Gemini API Configuration
GEMINI_API_KEY=your-production-gemini-api-key

# Security Configuration - IMPORTANT: Use a strong random secret
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_VERY_LONG_RANDOM_SECRET_AT_LEAST_256_BITS

# CORS Configuration - Set to your actual domain(s)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# GitHub Repository (format: username/repo-name)
# Example: johndoe/gemini-web-app
GITHUB_REPOSITORY=YOUR_GITHUB_USERNAME/YOUR_REPO_NAME

# Frontend API URL
VITE_API_URL=https://your-domain.com:8080

# Optional: Advanced Configuration
# ANONYMOUS_REQUEST_QUOTA=1
# REGISTERED_REQUEST_QUOTA=5
# JWT_EXPIRATION=86400000
